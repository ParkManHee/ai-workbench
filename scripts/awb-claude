#!/usr/bin/expect -f
# awb-claude [claude 인자…] — 폰 채널(plugin:phone@awb)을 붙여 터미널 claude 를 띄운다. 인자는 claude 로 그대로 간다.
# 조직 allowedChannelPlugins 없이 쓰려고 --dangerously-load-development-channels 로 띄우고, 그 경고 화면은 가린 채
# 자동으로 확인(Enter)한 뒤 일반 대화형 터미널로 넘긴다. 경고가 안 나오면(문구 변경 등) 잡아 둔 화면을 그대로 내놓는다.
log_user 0
set timeout 10
# 시스템 expect(Tcl 8.5)는 UTF-8 4바이트 글자(이모지)를 바이트별로 풀어 다시 인코딩해 「ð」 로 깨뜨린다 — 양쪽 채널을 바이트 그대로 통과시킨다
fconfigure exp0 -encoding binary
# bypass 를 shift+tab 순환에 넣는다 — 인자 없이 띄워도 빠지지 않게(시작 모드는 넘긴 인자대로)
# 할 일 도구(TaskCreate 등)는 이 변수 없이는 대화형에서도 없다 — 앱 할 일 바가 터미널 세션 목록도 읽게 켠다
set env(CLAUDE_CODE_ENABLE_TODO_TOOLS) 1
spawn -noecho claude --dangerously-load-development-channels plugin:phone@awb --allow-dangerously-skip-permissions {*}$argv
fconfigure $spawn_id -encoding binary
# 창 크기를 claude 쪽 pty 로 넘긴다 — spawn 은 크기를 복사하지 않아 0x0 이면 claude 가 아무것도 그리지 않는다.
# 바뀔 때마다 다시(stty 가 그 pty 의 전경 프로세스에 SIGWINCH 를 보낸다)
proc sync_size {} {
    global spawn_out
    catch { stty rows [stty rows] columns [stty columns] < $spawn_out(slave,name) }
}
sync_size
trap sync_size WINCH

proc finish {} {
    set w [wait]
    # 신호로 죽었으면 [pid id -1 errno CHILDKILLED SIGNAME 설명] — 셸 관례대로 128+번호
    if {[lindex $w 4] eq "CHILDKILLED"} {
        array set sig {SIGHUP 1 SIGINT 2 SIGQUIT 3 SIGKILL 9 SIGTERM 15}
        set n [lindex $w 5]
        exit [expr {[info exists sig($n)] ? 128 + $sig($n) : 1}]
    }
    exit [lindex $w 3]
}

# 경고 화면은 단어 사이가 커서 이동 escape 라 정규식 간격을 둔다. 신뢰 확인 화면도 「Enter to confirm」 이라
# 경고 제목을 본 뒤에만 Enter 를 보낸다(신뢰 화면의 기본값은 「No, exit」 이다)
set held ""
expect {
    -re {.+} {
        append held $expect_out(0,string)
        if {[regexp {Loading.{0,12}development.{0,12}channels} $held] && [regexp {Enter.{0,12}to.{0,12}confirm} $held]} {
            send "\r"
        } elseif {[regexp {Claude.{0,40}Code.{0,40}v[0-9]} $held]} {
            send_user -raw -- $held
        } else {
            exp_continue -continue_timer
        }
    }
    timeout { send_user -raw -- $held }
    eof { send_user -raw -- $held; finish }
}
log_user 1
interact
finish
